--- !u!114 &143437090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 143437089}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e87c8301ea2066c4fa30b33b64dca1db, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  introCanvasRoot: {fileID: 381509137}
  backgroundImage: {fileID: 439170616}
  illustrationImage: {fileID: 0}
  titleText: {fileID: 1891267995}
  bodyText: {fileID: 1408605810}
  nextButton: {fileID: 1048430888}
  skipButton: {fileID: 42220821}
  slides:
  - title: Harbor District, late 90s
    body: 'The harbor used to be the pride of the city.



      Ships, noise, money,
      neon. Now the cranes are rusty, and the new money is being made somewhere else.



      What''s
      left here is debt, old promises, and people who don''t have anywhere better
      to go.

'
    backgroundSprite: {fileID: -1838078694745771570, guid: 74bafd439f941f9478988a4fd2a42c25, type: 3}
    illustrationSprite: {fileID: 0}
  - title: The Lin Family
    body: 'For years, the Lin family kept this district under their name.



      They
      chased off worse gangs, kept the streets from eating themselves. In return,
      every shop paid their share.



      Some called it protection. Some called
      it extortion. Most people just called it survival.

'
    backgroundSprite: {fileID: -4364973992518566429, guid: c3f75e5981c51464e92f55c4b957af3c, type: 3}
    illustrationSprite: {fileID: 0}
  - title: New plans, old streets
    body: 'Developers want to turn the harbor into glass and steel.



      Politicians
      want headlines. Cops want easy arrests. Outside crews want a piece of the last
      dirty money left.



      The Lin family is caught in the middle, too old
      to change, too proud to disappear.

'
    backgroundSprite: {fileID: -5196509207228370742, guid: 5aaa41ad2923a8a42b9065d68d857882, type: 3}
    illustrationSprite: {fileID: 0}
  - title: You
    body: 'You are the new guy.



      No family. No savings. Just a sharp tongue
      and a head that stays cold when everyone else starts shouting.



      The
      Lin family gave you a place on this street. Tonight, they will find out what
      you are really good for.

'
    backgroundSprite: {fileID: 0}
    illustrationSprite: {fileID: 0}
  playerController: {fileID: 526636209}
  mainUICanvas: {fileID: 1373072595}
